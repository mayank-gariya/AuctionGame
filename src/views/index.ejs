<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Real-Time Auction</title>
    <style>
        body { font-family: system-ui, sans-serif; display: flex; justify-content: center; padding-top: 50px; background: #f4f4f5; }
        .auction-card { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); text-align: center; width: 350px; }
        .timer { font-size: 2rem; color: #dc2626; font-weight: bold; margin: 10px 0; }
        .stats { margin-bottom: 20px; font-size: 1.1rem; }
        input { padding: 10px; margin: 5px; border: 1px solid #ccc; border-radius: 4px; width: calc(100% - 24px); box-sizing: border-box; }
        button { padding: 10px 20px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-size: 1.1rem; margin-top: 10px; }
        button:hover { background: #1d4ed8; }
        button:disabled { background: #94a3b8; cursor: not-allowed; }
        .error { color: #dc2626; font-size: 0.9rem; margin-top: 10px; }
    </style>
</head>
<body>

    <div class="auction-card">
        <h2>Legendary Sword</h2>
        <div class="timer" id="timer">60s</div>
        
        <div class="stats">
            <p>Current Bid: $<strong id="current-bid">0</strong></p>
            <p>Highest Bidder: <strong id="highest-bidder">None</strong></p>
        </div>

        <input type="text" id="username" placeholder="Enter your name" required>
        <input type="number" id="bid-amount" placeholder="Enter bid amount" required>
        <button id="bid-btn" onclick="submitBid()">Place Bid</button>
        
        <p class="error" id="message"></p>
    </div>

    <!-- Automatically served by the Socket.IO backend -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();

        const currentBidEl = document.getElementById('current-bid');
        const highestBidderEl = document.getElementById('highest-bidder');
        const timerEl = document.getElementById('timer');
        const messageEl = document.getElementById('message');
        const bidBtn = document.getElementById('bid-btn');

        // Handle full state syncs (on connection or new successful bid)
        socket.on('stateUpdate', (data) => {
            currentBidEl.innerText = data.currentBid;
            highestBidderEl.innerText = data.highestBidder;
            timerEl.innerText = data.timeLeft + 's';
            messageEl.innerText = ''; // Clear errors
            messageEl.style.color = '#16a34a'; // Green
        });

        // Handle timer ticks
        socket.on('TimeLeft', (time) => {
            timerEl.innerText = time + 's';
        });

        // Handle rejected bids
        socket.on('bidRejected', (reason) => {
            messageEl.style.color = '#dc2626'; // Red
            messageEl.innerText = reason;
        });

        // Handle auction end
        socket.on('auctionEnded', (data) => {
            timerEl.innerText = "ENDED";
            messageEl.style.color = '#2563eb'; // Blue
            messageEl.innerText = `Sold to ${data.winner} for $${data.amount}!`;
            bidBtn.disabled = true;
        });

        function submitBid() {
            const username = document.getElementById('username').value.trim();
            const bid = parseInt(document.getElementById('bid-amount').value);

            if (!username) {
                messageEl.innerText = 'Please enter a name first.';
                return;
            }
            if (isNaN(bid)) {
                messageEl.innerText = 'Please enter a valid amount.';
                return;
            }

            socket.emit('PlaceBid', { username, bid });
            document.getElementById('bid-amount').value = '';
        }
    </script>
</body>
</html>